    <BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../styles/main.css" fx:controller="com.task_manager.View.MainViewController">
        <!-- Левая часть -->
        <left>
            <!-- Контейнер для всего содержимого прямоугольника -->
            <StackPane fx:id="rectangleWithContent" styleClass="rectangle-with-content" maxWidth="350">
                <!-- Белый прямоугольник -->
                <Rectangle fx:id="tasksRectangle" width="350" height="750" styleClass="rectangle" />

                <!-- Верхний контейнер с текстом и кнопками -->
                <HBox fx:id="headerBox" styleClass="header-box">
                    <Label fx:id="recentTasksLabel" text="Recent Tasks" styleClass="section-title" />
                    <HBox HBox.hgrow="ALWAYS" />
                    <HBox fx:id="buttonsBox" styleClass="buttons-box">
                        <Button fx:id="plusButton" text="+" styleClass="add-button" onAction="#showAddTaskDialog" />
                        <Button fx:id="allButton" text="All >" styleClass="view-all-button" onAction="#showAllTask" />
                    </HBox>
                </HBox> 
                <!-- Линия под заголовком -->
                <Line fx:id="recentaskLine" startX="0" endX="350" styleClass="line" />
                <StackPane styleClass="notes-scroll-container">
                    <ScrollPane styleClass="notes-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                        <VBox styleClass="vbox-scrollable">
                            <!-- Секция "Yesterday" -->
                            <VBox fx:id="yesterdaySection" styleClass="task-section">
                                <HBox styleClass="center">
                                    <Label fx:id="yesterdayLabel" text="Yesterday" styleClass="section-title" />
                                </HBox>
                                <VBox fx:id="tasksContainerYesterday" styleClass="vbox-scrollable">
                                    <HBox alignment="CENTER_LEFT" styleClass="task-container">
                                        <CheckBox fx:id="checkbox1" />
                                        <VBox>
                                            <HBox>
                                                <Label text="Task 1" styleClass="task-name" />
                                                <HBox styleClass="clock-container" spacing="5" alignment="CENTER_LEFT">
                                                    <ImageView fx:id="clockIcon1" fitWidth="16" fitHeight="16" />
                                                    <Label fx:id="deadlineLabel1" text="25.01.2025" visible="false" />
                                                </HBox>
                                            </HBox>
                                            <Label text="This is the description of Task 1." styleClass="task-description" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <Line fx:id="yesterdayLine" startX="0" endX="350" strokeWidth="2" styleClass="line" />
                            </VBox>

                            <!-- Секция "Today" -->
                            <VBox fx:id="todaySection" styleClass="task-section">
                                <HBox styleClass="center">
                                    <Label fx:id="todayLabel" text="Today" styleClass="section-title" alignment="CENTER" />
                                </HBox>
                                <VBox fx:id="tasksContainerToday" spacing="10" styleClass="vbox-scrollable">
                                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="task-container">
                                        <CheckBox fx:id="checkbox4" />
                                        <VBox>
                                            <HBox>
                                                <Label text="Task 4" styleClass="task-name" />
                                                <HBox styleClass="clock-container" spacing="5" alignment="CENTER_LEFT">
                                                    <ImageView fx:id="clockIcon2" fitWidth="16" fitHeight="16" />
                                                    <Label fx:id="deadlineLabel2" text="25.01.2025" visible="false" />
                                                </HBox>
                                            </HBox>
                                            <Label text="This is the description of Task 4." styleClass="task-description" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <Line fx:id="todayLine" startX="0" endX="350" strokeWidth="2" styleClass="line" />
                            </VBox>

                            <!-- Секция "Tomorrow" -->
                            <VBox fx:id="tomorrowSection" styleClass="task-section">
                                <HBox styleClass="center">
                                    <Label fx:id="tomorrowLabel" text="Tomorrow" styleClass="section-title" alignment="CENTER" />
                                </HBox>
                                <VBox fx:id="tasksContainerTomorrow" spacing="10" styleClass="vbox-scrollable">
                                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="task-container">
                                        <CheckBox fx:id="checkbox7" />
                                        <VBox>
                                            <HBox>
                                                <Label text="Task 7" styleClass="task-name" />
                                                <HBox styleClass="clock-container" spacing="5" alignment="CENTER_LEFT">
                                                    <ImageView fx:id="clockIcon3" fitWidth="16" fitHeight="16" />
                                                    <Label fx:id="deadlineLabel3" text="25.01.2025" visible="false" />
                                                </HBox>
                                            </HBox>
                                            <Label text="This is the description of Task 7." styleClass="task-description" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </StackPane>
            </StackPane>
        </left>
