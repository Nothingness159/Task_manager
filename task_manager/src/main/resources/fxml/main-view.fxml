                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </StackPane>
                </VBox>
            </StackPane>
        </StackPane>
    </left>
   <center>
    <VBox spacing="20" styleClass="center-container" maxWidth="450">
        <!-- Первый прямоугольник -->
        <StackPane styleClass="folders-pane" prefWidth="450" prefHeight="230">
            <Rectangle width="450" height="230" styleClass="rectangle" />
            <!-- Контейнер для текста и кнопок -->
            <VBox styleClass="main-container">
                <HBox styleClass="header-box">
                    <Label fx:id="foldersLabel" text="Folders" styleClass="section-title" />
                    <HBox HBox.hgrow="ALWAYS" />
                    <HBox styleClass="buttons-box">
                        <Button fx:id="plusButton2" text="+" styleClass="plus-button" />
                        <Button fx:id="allButton2" text="All >" styleClass="all-button" />
                    </HBox>
                </HBox>
                <!-- Линия под текстом и кнопками -->
                <Line startX="0" endX="450" startY="0" endY="0" styleClass="line" />
            </VBox>
        </StackPane>

        <!-- Второй прямоугольник -->
        <StackPane styleClass="statistic-pane" prefWidth="450" prefHeight="510">
            <Rectangle width="450" height="510" styleClass="rectangle" />
            <!-- Добавь содержимое для второго прямоугольника, если нужно -->
        </StackPane>
    </VBox>
</center>
