                                            </VBox>
                                        </HBox>
                                    </VBox>
                                    <Line fx:id="yesterdayLine" startX="0" endX="350" strokeWidth="2" styleClass="line" />
                                </VBox>

                                <!-- Секция "Today" -->
                                <VBox fx:id="todaySection" styleClass="task-section">
                                    <Label fx:id="todayLabel" text="Today" styleClass="section-title" alignment="CENTER" />
                                    <VBox fx:id="tasksContainerToday" spacing="10" styleClass="vbox-scrollable">
                                        <HBox spacing="20" alignment="CENTER_LEFT">
                                            <CheckBox fx:id="checkbox4" />
                                            <VBox>
                                                <Label text="Task 4" styleClass="task-name" />
                                                <Label text="This is the description of Task 4." styleClass="task-description" />
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                    <Line fx:id="todayLine" startX="0" endX="350" strokeWidth="2" styleClass="line" />
                                </VBox>

                                <!-- Секция "Tomorrow" -->
                                <VBox fx:id="tomorrowSection" styleClass="task-section">
                                    <Label fx:id="tomorrowLabel" text="Tomorrow" styleClass="section-title" alignment="CENTER" />
                                    <VBox fx:id="tasksContainerTomorrow" spacing="10" styleClass="vbox-scrollable">
                                        <HBox spacing="20" alignment="CENTER_LEFT">
                                            <CheckBox fx:id="checkbox7" />
                                            <VBox>
