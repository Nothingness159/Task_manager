<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../styles/main.css" fx:controller="com.task_manager.View.MainViewController">
    <!-- Левая часть -->
    <left>
        <StackPane fx:id="leftPane" styleClass="left-pane">
            <!-- Контейнер для всего содержимого прямоугольника -->
            <StackPane fx:id="rectangleWithContent" styleClass="rectangle-with-content">
                <!-- Белый прямоугольник -->
                <Rectangle fx:id="tasksRectangle" width="350" height="750" styleClass="rectangle" />

                <!-- Основной вертикальный контейнер -->
                <VBox styleClass="main-container">
                    <!-- Верхний контейнер с текстом и кнопками -->
                    <HBox fx:id="headerBox" styleClass="header-box">
                        <Label fx:id="recentTasksLabel" text="Recent Tasks" styleClass="section-title" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <HBox fx:id="buttonsBox" styleClass="buttons-box">
                            <Button fx:id="plusButton" text="+" styleClass="plus-button" onAction="#showAddTaskDialog"/>
                            <Button fx:id="allButton" text="All >" styleClass="all-button" />
                        </HBox>
                    </HBox>

                    <!-- Линия под заголовком -->
                    <Line fx:id="recentaskLine" startX="0" endX="350" startY="0" endY="0" styleClass="line" />

                    <!-- Контейнер для ScrollPane с скругленными углами -->
                    <StackPane styleClass="rounded-scroll-container">
                        <ScrollPane fx:id="mainScrollPane" styleClass="scroll-pane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                            <VBox fx:id="tasksSectionsContainer" spacing="20" styleClass="vbox-scrollable">
                                <!-- Секция "Yesterday" -->
                                <VBox fx:id="yesterdaySection" styleClass="task-section">
                                    <Label fx:id="yesterdayLabel" text="Yesterday" styleClass="section-title" alignment="CENTER" />
                                    <VBox fx:id="tasksContainerYesterday" spacing="10" styleClass="vbox-scrollable">
                                        <HBox spacing="20" alignment="CENTER_LEFT">
                                            <CheckBox fx:id="checkbox1" />
                                            <VBox>
