<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.task_manager.View.AddTaskController">
    <StackPane fx:id="addTaskPane" styleClass="add-task-pane" >
        
        <!-- Основной контейнер с отступами -->
        <VBox spacing="15" alignment="TOP_CENTER" styleClass="add-task-container">
            <VBox.margin>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </VBox.margin>

            <!-- Название задачи -->
            <TextField fx:id="taskNameField" promptText="Task Name" styleClass="task-input" />

            <!-- Описание задачи -->
            <TextField fx:id="taskDescriptionField" promptText="Task Description" styleClass="task-input" />

            <!-- Дата и время дедлайна -->
            <HBox spacing="10">
                <DatePicker fx:id="deadlineDatePicker" promptText="Deadline Date" styleClass="task-input" HBox.hgrow="ALWAYS" />
                <TextField fx:id="deadlineTimeField" promptText="Time (HH:mm)" styleClass="task-input" prefWidth="100" />
            </HBox>

            <!-- Сложность и папка -->
            <HBox spacing="10">
                <ComboBox fx:id="difficultyComboBox" promptText="Difficulty" styleClass="task-input" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="folderComboBox" promptText="Folder" styleClass="task-input" HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Кнопки -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="addTaskButton" text="Confirm" styleClass="confirm-button" onAction="#addTask" />
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>